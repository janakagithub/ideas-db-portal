// IDEAS-DB schema — generated 2026-09-23
// Paste into https://dbdiagram.io/ (DBML). Source columns are TEXT;
// types below are the intended ANSI types from ideas_min_schema.sql.
// Relationship notes: DECLARED = SQL FK; *_INFERRED = naming + value match; UNKNOWN = unverifiable.

Table ai_design {
  id text [pk, note: 'Row id.']
  idea_protein_id text [ref: > idea_protein.id, note: 'STRONGLY_INFERRED 100.0% match']
  design_method text [note: 'Method.']
  model_name text [note: 'Model used.']
  proposed_mutations text [note: 'Proposed mutations.']
  proposed_sequence text [note: 'Proposed sequence.']
  optimization_target text [note: 'Objective.']
  optimization_algorithm text [note: 'Algorithm.']
  generation text [note: 'Design generation.']
  objective_scores text [note: 'Objective scores.']
  pareto_rank text [note: 'Pareto rank.']
  pareto_optimal text [note: 'On Pareto front?']
  selected_for_testing text [note: 'Chosen for wet-lab test?']
  design_rationale text [note: 'Rationale.']
  run_date text [note: 'Run date.']
  notes text [note: 'Notes.']
}
Note: table ai_design row_count is 5

Table computation {
  id text [pk, note: 'Row id.']
  idea_protein_id text [ref: > idea_protein.id, note: 'STRONGLY_INFERRED 100.0% match']
  idea_mutant_id text [ref: > idea_mutant.id, note: 'STRONGLY_INFERRED 100.0% match']
  idea_reaction_id text [ref: > idea_reaction.id, note: 'STRONGLY_INFERRED 100.0% match']
  procedure_id text [ref: > idea_procedure.id, note: 'STRONGLY_INFERRED 100.0% match']
  type text [note: 'Type.']
  model_name text [note: 'Model.']
  compute_platform text [note: 'Platform.']
  simulation_params text [note: 'Parameters.']
  run_date text [note: 'Date.']
  filename text [note: 'Output file.']
  notes text [note: 'Notes.']
}
Note: table computation row_count is 5

Table idea_dbxref {
  id integer [pk, note: 'Row id.']
  entity_type text [note: 'Which entity type.']
  entity_id text [note: 'Which entity.']
  database_name text, [note: 'External DB.']
  accession text [note: 'External accession.']
  url text [note: 'External URL.']
}
Note: table idea_dbxref row_count is 13

Table idea_experiment {
  id text [pk, note: 'Experiment identifier.']
  start_date date [note: 'When the experiment began (not populated).']
  type text [note: 'Experiment/assay type (e.g. the 6,6 polymer type).']
  index_num integer [note: 'Ordinal index (not populated).']
  description text [note: 'Human description / project tag.']
  procedure_id text [ref: > idea_procedure.id, note: 'STRONGLY_INFERRED 100.0% match']
}
Note: table idea_experiment row_count is 1

Table idea_lab {
  id text [pk, note: 'Row id.']
  name text [note: 'Lab name.']
  location text [note: 'Lab location.']
}
Note: table idea_lab row_count is 2

Table idea_measurement {
  id integer [pk, note: 'Measurement identifier.']
  sample_id text [ref: > idea_sample.id, note: 'DECLARED 100.0% match']
  procedure_id text [ref: > idea_procedure.id, note: 'STRONGLY_INFERRED 100.0% match']
  type text [note: 'Measurement type (mass-spec, titer assay, …).']
  filename text [note: 'Source data file, if any.']
  notes text [note: 'Free-text notes.']
}
Note: table idea_measurement row_count is 27

Table idea_mutant {
  id text [pk, note: 'Stable internal identifier for the variant.']
  idea_protein_id text [ref: > idea_protein.id, note: 'STRONGLY_INFERRED 100.0% match']
  mutations text [note: 'Mutation(s) in standard notation, e.g. A219M or V213L A215Q; empty for wild-type']
  aa_sequence text [note: 'Variant amino-acid sequence (not yet populated).']
  dna_sequence text [note: 'Variant coding DNA sequence (not yet populated).']
  design_method text [note: 'How the variant was made (site-directed, combinatorial, site-saturation, wild-ty']
  ai_design_id text [ref: > ai_design.id, note: 'WEAKLY_INFERRED']
  notes text [note: 'Free-text notes.']
}
Note: table idea_mutant row_count is 21

Table idea_people {
  id text [pk, note: 'Row id.']
  first_name text [note: 'First name.']
  last_name text [note: 'Last name.']
  email text [note: 'Email.']
  lab_id text [ref: > idea_lab.id, note: 'STRONGLY_INFERRED 100.0% match']
}
Note: table idea_people row_count is 6

Table idea_procedure {
  id text [pk, note: 'Row id.']
  protocol_id text [ref: > idea_protocol.id, note: 'STRONGLY_INFERRED 100.0% match']
  lab_id text [ref: > idea_lab.id, note: 'STRONGLY_INFERRED 100.0% match']
  contact_id text [ref: > idea_people.id, note: 'STRONGLY_INFERRED 100.0% match']
  timestamp text [note: 'When performed.']
}
Note: table idea_procedure row_count is 6

Table idea_protein {
  id text [pk, note: 'Stable internal identifier for the enzyme.']
  kb_protein_id text
  kb_genome_id text
  name text [note: 'Enzyme name as used in the paper (e.g. AcsA, AS9).']
  aa_sequence text [note: 'Protein amino-acid sequence (populated for the six named enzymes from UniProt/PD']
  dna_sequence text [note: 'Coding DNA sequence (not yet populated).']
  structure_url text [note: 'Link to a 3-D structure (RCSB PDB) — populated for enzymes with a solved structu']
  source_organism text [note: 'Organism the enzyme derives from (populated for the named enzymes).']
  source_type text [note: 'Kind of entity — enzyme here.']
  notes text [note: 'Free-text notes.']
}
Note: table idea_protein row_count is 1

Table idea_protocol {
  id text [pk, note: 'Row id.']
  description text [note: 'Protocol description.']
  filename text [note: 'Protocol file.']
}
Note: table idea_protocol row_count is 6

Table idea_reactant {
  id text [pk, note: 'Stable internal identifier for the chemical.']
  kb_metabolite_id text
  name text [note: 'Chemical name as used in the paper.']
  aliases text [note: 'Alternate names (not yet populated).']
  smiles text [note: 'SMILES structure string.']
  inchi text [note: 'InChI structure string (not yet populated).']
  inchi_key text [note: 'InChIKey (hashed structure id) — populated for the real monomer/substrate chemic']
  molecular_formula text [note: 'Molecular formula — populated for the real monomer/substrate chemicals via PubCh']
  molecular_weight real [note: 'Monoisotopic/observed mass (m/z) — populated for measured products.']
  notes text [note: 'Free-text notes, incl. whether the row is a synthesized product.']
}
Note: table idea_reactant row_count is 8

Table idea_reaction {
  id text [pk, note: 'Stable internal identifier for the reaction.']
  kb_reaction_id text
  name text [note: 'Human label, e.g. Diad synthesis: Adipic acid and Hexamethylenediamine.']
  equation text [note: 'The substrate pair / reaction description as given in the source.']
  smarts text [note: 'Reaction SMARTS pattern (not yet populated).']
  reaction_type text [note: 'Reaction class: Diad / Triad / Tetrad / MAXA / N66 synthesis.']
  notes text [note: 'Free-text notes (e.g. inferred-substrate or unresolved-code flags).']
}
Note: table idea_reaction row_count is 3

Table idea_sample {
  id text [pk, note: 'Sample identifier.']
  name text [note: 'Human label encoding enzyme|substrate|replicate for readability.']
  experiment_id text [ref: > idea_experiment.id, note: 'DECLARED 100.0% match']
  strain_id text [ref: > idea_strain.id, note: 'STRONGLY_INFERRED 100.0% match']
  procedure_id text [ref: > idea_procedure.id, note: 'WEAKLY_INFERRED']
  replicate integer [note: 'Replicate number (1..N) — each source replicate is its own sample row.']
  parent_sample_id text [ref: > idea_sample.id, note: 'DECLARED']
  storage_location text [note: 'Plate position or storage note (e.g. row C col 1).']
  notes text [note: 'Free-text notes.']
}
Note: table idea_sample row_count is 27

Table idea_stoichiometry {
  id integer [pk, note: 'Row identifier.']
  idea_reaction_id text [ref: > idea_reaction.id, note: 'DECLARED 100.0% match']
  idea_reactant_id text [ref: > idea_reactant.id, note: 'DECLARED 100.0% match']
  coefficient real [note: 'Stoichiometric coefficient (−1 substrate, +1 product here).']
  role text [note: 'substrate or product.']
  notes text [note: 'Free-text notes.']
}
Note: table idea_stoichiometry row_count is 10

Table idea_strain {
  id text [pk, note: 'Row identifier.']
  long_name text [note: 'Full strain name.']
  short_name text [note: 'Short strain label.']
  parent_strain_id text [ref: > idea_strain.id, note: 'WEAKLY_INFERRED 0.0% match']
}
Note: table idea_strain row_count is 2

Table protein_parameter {
  id text [pk, note: 'Row identifier.']
  idea_protein_id text [ref: > idea_protein.id, note: 'STRONGLY_INFERRED 100.0% match']
  idea_mutant_id text [ref: > idea_mutant.id, note: 'STRONGLY_INFERRED 100.0% match']
  label text [note: 'What is measured, e.g. N66 L1 titer (avg).']
  value text [note: 'The numeric value (typed REAL).']
  unit text [note: 'Unit, e.g. mg/L.']
  error text [note: 'Uncertainty — here the standard deviation of replicates.']
  measurement_id text [ref: > idea_measurement.id, note: 'WEAKLY_INFERRED 0.0% match']
  computation_id text [ref: > computation.id, note: 'WEAKLY_INFERRED 0.0% match']
  idea_reaction_id text [ref: > idea_reaction.id, note: 'STRONGLY_INFERRED 100.0% match']
  notes text [note: 'Free-text notes.']
}
Note: table protein_parameter row_count is 86

Table sample_parameter {
  id integer [pk, note: 'Row identifier.']
  sample_id text [ref: > idea_sample.id, note: 'DECLARED 100.0% match']
  label text [note: 'What is measured: mass-spec intensity, titer, conversion, N66 L1 titer.']
  value text [note: 'The value as text (typed via value_type).']
  unit text [note: 'Unit: intensity (a.u.), mg/L, %.']
}
